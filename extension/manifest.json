{
  "manifest_version": 3,
  "name": "YT-DLP Minimalist — Enviar video",
  "version": "1.0.3",
  "description": "Envía la URL de la pestaña actual a YT-DLP Minimalist para descargarla con yt-dlp.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Enviar a YT-DLP Minimalist",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:14370/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["url-utils.js", "i18n.js", "content-overlay.js"],
      "css": ["content-overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
